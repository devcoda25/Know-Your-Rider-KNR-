APP_NAME="KNR Gateway"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

CACHE_STORE=file
QUEUE_CONNECTION=sync

# Shared secrets (must match the auth service). Change both outside local dev.
JWT_SECRET=dev-only-change-me-to-a-long-random-string-0123456789
INTERNAL_API_KEY=dev-only-internal-key-change-me-0123456789

# Upstream services (docker compose service names)
AUTH_SERVICE_URL=http://auth:8000
REGISTRY_SERVICE_URL=http://registry:8000
GATEWAY_TIMEOUT=15

# Browser origins allowed to call the gateway (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000
