APP_NAME="KNR Auth"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=knr_auth
DB_USERNAME=knr
DB_PASSWORD=knr_secret

CACHE_STORE=file
QUEUE_CONNECTION=sync

JWT_SECRET=dev-only-change-me-to-a-long-random-string-0123456789
INTERNAL_API_KEY=dev-only-internal-key-change-me-0123456789
JWT_TTL_MINUTES=720

# OTP: "log" writes the code to storage/logs (dev). Swap for a real SMS driver later.
SMS_DRIVER=log
OTP_TTL_MINUTES=5
# Dev only: include the OTP in the API response so you can sign in without SMS.
OTP_DEBUG_RETURN=true
