APP_NAME="KNR Registry"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8002

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=knr_registry
DB_USERNAME=knr
DB_PASSWORD=knr_secret

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

INTERNAL_API_KEY=dev-only-internal-key-change-me-0123456789

# Base URL printed inside rider QR codes (the public scan page in apps/admin-web).
PUBLIC_SCAN_URL=http://localhost:3000/r

# Public gateway URL used to build photo links returned to clients.
GATEWAY_PUBLIC_URL=http://localhost:8000/api/v1
AUTH_SERVICE_URL=http://auth:8000
